# Render output and working files — the site does not load any of these.
# assets/idle alone is 472MB of PNG frames left over from the falcon renders.
assets/idle/
comfy/
shots/
data/
# Root-level render exports only. NOT assets/anim/*.mp4 - those are the H.264
# fallbacks the <source> list falls back to, and they are the ONLY falcon
# footage Safari and iOS can play, because neither supports WebM. A blanket
# *.mp4 excluded them and the hero animation 404'd on the live site.
/*.mp4

# Editor/OS and local server leftovers
node_modules/
.DS_Store
Thumbs.db

# The .bak files kept while iterating on the CSS and markup
*.bak
*.bak-*
*.orig
